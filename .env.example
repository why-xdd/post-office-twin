# Адрес PostgreSQL. Если не задан, планы хранятся в SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/plan_ops

# Файл SQLite, когда DATABASE_URL не задан.
OPS_TWIN_DB=storage/plans.sqlite

# Необязательно: путь к примеру плана и к собранному клиенту.
# OPS_TWIN_SAMPLE=data/demo_plan.json
# OPS_TWIN_WEB=apps/web/dist

# Порт в контейнере.
PORT=8000
