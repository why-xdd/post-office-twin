# Адрес PostgreSQL. Если не задан, планы хранятся в SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/plan_ops

# Файл SQLite, когда DATABASE_URL не задан.
OPS_TWIN_DB=storage/plans.sqlite

# Необязательно: путь к примеру плана и к собранному клиенту.
# OPS_TWIN_SAMPLE=data/demo_plan.json
# OPS_TWIN_WEB=apps/web/dist

# Порт в контейнере.
PORT=8000

# Сколько секунд ассистент тратит на подбор рекомендаций для одного плана.
# Когда время кончается, ответ приходит неполным, но приходит.
# OPS_TWIN_ASSISTANT_BUDGET=25

# Сколько тяжёлых расчётов идёт одновременно и сколько ждать своей очереди.
# OPS_TWIN_MAX_PARALLEL=1
# OPS_TWIN_WAIT_TIMEOUT=45

# Необязательно: разбор команд словами языковой моделью вместо словарного разбора.
# Без этих переменных сервис работает без сети и разбирает фразы сам.
# Подходит любой совместимый с OpenAI адрес /chat/completions — облачный или локальный.
# OPS_TWIN_LLM_URL=http://localhost:11434/v1/chat/completions
# OPS_TWIN_LLM_MODEL=qwen2.5:7b-instruct
# OPS_TWIN_LLM_KEY=
# OPS_TWIN_LLM_TIMEOUT=8
